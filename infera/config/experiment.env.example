# Copia este archivo como config/experiment.env y reemplaza solo los valores
# correspondientes a tu entorno. El archivo real no debe contener tokens ni
# credenciales.

# Rutas locales o identificadores de los dos modelos servidos.
FP16_MODEL=/models/llama3.1-8b-instruct
AWQ_MODEL=/models/llama3.1-8b-instruct-awq

# Entrada del ejemplo. Copia session_tasks.example.json con otro nombre y
# reemplaza estos valores antes de una corrida completa.
SESSION=config/session_tasks.example.json
SESSION_TAG=mi_experimento
KB_DIR=kb

# Política. THRESH se compara con los tokens del prompt informados por vLLM.
# No es un umbral óptimo. Debe dejar margen para la salida dentro de
# MAX_MODEL_LEN.
THRESH=4500
MAX_MODEL_LEN=8192
EXPECTED_TASKS=3
# El ejemplo mínimo no alcanza el umbral. Para una medición de compactación,
# amplía la sesión y declara aquí cuántos resúmenes esperas observar.
EXPECTED_COMPACTIONS=0

# Réplicas, servicio y estabilización.
REPS=3
PORT=8000
COOL=120
# Directorio opcional. Si se omite, overnight.sh crea una carpeta fechada
# dentro de results/runs/. Nunca apuntes a results/reference/.
# OUTPUT_ROOT=results/runs/mi_politica
