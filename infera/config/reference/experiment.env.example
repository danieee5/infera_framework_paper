# Parámetros de la configuración publicada. Copia este archivo únicamente si
# quieres repetir el diseño del paper en una nueva GPU.

FP16_MODEL=/models/llama3.1-8b-instruct
AWQ_MODEL=/models/llama3.1-8b-instruct-awq

SESSION=config/reference/session_tasks.json
# La etiqueta v3 se conserva porque forma parte de los nombres originales.
SESSION_TAG=v3
KB_DIR=kb

THRESH=4500
MAX_MODEL_LEN=8192
EXPECTED_TASKS=29
EXPECTED_COMPACTIONS=3

# Campaña fija de tres brazos. El descarte conserva los K pares completos más
# recientes. K=4 es un parámetro predeclarado y libre: no garantiza la misma
# ocupación que un resumen; el análisis informa la ocupación realizada.
PARES_CONSERVADOS=4
# Medición de la GPU en reposo al inicio de cada sesión, en segundos.
SEGUNDOS_REPOSO=30

REPS=3
PORT=8000
COOL=120
WARMUP=5
# Espera sin peticiones entre el warmup de cada sesión y su baseline.
POST_WARMUP_SETTLE_S=30
REQUEST_TIMEOUT_S=600
STARTUP_TIMEOUT_S=600
SHUTDOWN_TIMEOUT_S=60
# Se permite un segundo intento solo si vLLM falla antes de iniciar el bloque.
# Las peticiones medidas nunca se reintentan.
SERVER_START_ATTEMPTS=2

# La campaña deja la caché de prefijos apagada: vLLM 0.5.3 solo la activa al
# pasar --enable-prefix-caching. Cambiarlo define otro sistema experimental.

# OUTPUT_ROOT=results/runs/repeticion_referencia
